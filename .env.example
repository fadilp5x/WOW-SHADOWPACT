# Required for live scans. Server-only. Never use a VITE_ prefix.
TINYFISH_API_KEY=

# Optional: full service-account JSON enables server-side Firestore caching.
# Leave Firebase unset to use browser caching.
FIREBASE_SERVICE_ACCOUNT=

# Advanced alternatives to a service account. Usually leave these unset.
FIREBASE_CONFIG=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_TOKEN=
